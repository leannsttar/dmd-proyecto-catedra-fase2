<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>t03_dim_cliente</name>
    <description>Carga Dim_Cliente desde la hoja Clientes (Fase 1, Tabla 10).</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
      <parameter>
        <name>DW_HOST</name>
        <default_value>localhost</default_value>
        <description>Servidor de SQL Server</description>
      </parameter>
      <parameter>
        <name>DW_PORT</name>
        <default_value>1433</default_value>
        <description>Puerto TCP de SQL Server</description>
      </parameter>
      <parameter>
        <name>DW_DB</name>
        <default_value>AndinaRetailDW</default_value>
        <description>Base de datos del Datawarehouse</description>
      </parameter>
    </parameters>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <capture_step_performance>N</capture_step_performance>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
    <notepad>
      <note>Select values convierte FechaRegistro (texto) a fecha y renombra las columnas. Las fechas que no se pueden convertir y los ClienteID repetidos van a Etl_Rechazos con su causa.
cliente_key = 1..n en orden de cliente_id (D1). segmento_cluster viene del resultado de K-means (mining/output/segmentos_cliente.csv, decisión D3).</note>
      <xloc>40</xloc>
      <yloc>20</yloc>
      <width>700</width>
      <heigth>80</heigth>
      <fontname>Segoe UI</fontname>
      <fontsize>9</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>244</backgroundcolorgreen>
      <backgroundcolorblue>206</backgroundcolorblue>
      <bordercolorred>100</bordercolorred>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorblue>100</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
  </notepads>
  <connection>
    <name>AndinaRetailDW</name>
    <server>${DW_HOST}</server>
    <type>MSSQLNATIVE</type>
    <access>Native</access>
    <database>${DW_DB}</database>
    <port>${DW_PORT}</port>
    <username/>
    <password>Encrypted </password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute>
        <code>MSSQLUseIntegratedSecurity</code>
        <attribute>true</attribute>
      </attribute>
      <attribute>
        <code>EXTRA_OPTION_MSSQLNATIVE.encrypt</code>
        <attribute>true</attribute>
      </attribute>
      <attribute>
        <code>EXTRA_OPTION_MSSQLNATIVE.trustServerCertificate</code>
        <attribute>true</attribute>
      </attribute>
      <attribute>
        <code>PORT_NUMBER</code>
        <attribute>${DW_PORT}</attribute>
      </attribute>
      <attribute>
        <code>FORCE_IDENTIFIERS_TO_LOWERCASE</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>FORCE_IDENTIFIERS_TO_UPPERCASE</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>IS_CLUSTERED</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>PRESERVE_RESERVED_WORD_CASE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>QUOTE_ALL_FIELDS</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>SUPPORTS_BOOLEAN_DATA_TYPE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>SUPPORTS_TIMESTAMP_DATA_TYPE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>USE_POOLING</code>
        <attribute>N</attribute>
      </attribute>
    </attributes>
  </connection>
  <order>
    <hop>
      <from>Leer hoja Clientes</from>
      <to>Renombrar columnas</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Renombrar columnas</from>
      <to>Clientes únicos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Clientes únicos</from>
      <to>Convertir fecha_registro</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Convertir fecha_registro</from>
      <to>Ordenar por cliente_id</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ordenar por cliente_id</from>
      <to>Asignar cliente_key</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Asignar cliente_key</from>
      <to>Agregar segmento_cluster</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Agregar segmento_cluster</from>
      <to>Cargar Dim_Cliente</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Leer segmentos de K-means</from>
      <to>Agregar segmento_cluster</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Rechazo: ClienteID duplicado</from>
      <to>Rechazo: ClienteID duplicado: columnas</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Rechazo: fecha no convertible</from>
      <to>Rechazo: fecha no convertible: columnas</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Clientes únicos</from>
      <to>Rechazo: ClienteID duplicado</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Convertir fecha_registro</from>
      <to>Rechazo: fecha no convertible</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Rechazo: ClienteID duplicado: columnas</from>
      <to>Unir rechazos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Rechazo: fecha no convertible: columnas</from>
      <to>Unir rechazos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Unir rechazos</from>
      <to>Fila de la hoja (rechazos)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Fila de la hoja (rechazos)</from>
      <to>Sumar encabezado (rechazos)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sumar encabezado (rechazos)</from>
      <to>Columnas finales (rechazos)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Columnas finales (rechazos)</from>
      <to>Ordenar rechazos por fila</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ordenar rechazos por fila</from>
      <to>Agregar base de rechazos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Agregar base de rechazos</from>
      <to>Numerar rechazos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Numerar rechazos</from>
      <to>Calcular rechazo_id</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Calcular rechazo_id</from>
      <to>Cargar Etl_Rechazos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Último id de rechazos</from>
      <to>Agregar base de rechazos</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Leer hoja Clientes</name>
    <type>ExcelInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <header>Y</header>
    <noempty>Y</noempty>
    <stoponempty>N</stoponempty>
    <filefield/>
    <sheetfield/>
    <sheetrownumfield/>
    <rownumfield>fila_excel</rownumfield>
    <limit>0</limit>
    <encoding/>
    <add_to_result_filenames>N</add_to_result_filenames>
    <accept_filenames>N</accept_filenames>
    <accept_field/>
    <accept_stepname/>
    <file>
      <name>${Internal.Entry.Current.Directory}/../data/raw/datos_andina_retail_corp.xlsx</name>
      <filemask/>
      <exclude_filemask/>
      <file_required>Y</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field>
        <name>ClienteID</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>Nombre</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>Segmento</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>Region</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>FechaRegistro</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>VisitasWeb2024</name>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>ConversionesWeb2024</name>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
    </fields>
    <sheets>
      <sheet>
        <name>Clientes</name>
        <startrow>0</startrow>
        <startcol>0</startcol>
      </sheet>
    </sheets>
    <strict_types>N</strict_types>
    <error_ignored>N</error_ignored>
    <error_line_skipped>N</error_line_skipped>
    <bad_line_files_destination_directory/>
    <bad_line_files_extension>warning</bad_line_files_extension>
    <error_line_files_destination_directory/>
    <error_line_files_extension>error</error_line_files_extension>
    <line_number_files_destination_directory/>
    <line_number_files_extension>line</line_number_files_extension>
    <shortFileFieldName/>
    <pathFieldName/>
    <hiddenFieldName/>
    <lastModificationTimeFieldName/>
    <uriNameFieldName/>
    <rootUriNameFieldName/>
    <extensionFieldName/>
    <sizeFieldName/>
    <spreadsheet_type>POI</spreadsheet_type>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>40</xloc>
      <yloc>170</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Renombrar columnas</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>fila_excel</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>ClienteID</name>
        <rename>cliente_id</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>Nombre</name>
        <rename>nombre</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>Segmento</name>
        <rename>segmento</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>FechaRegistro</name>
        <rename>fecha_registro</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>200</xloc>
      <yloc>170</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Clientes únicos</name>
    <type>UniqueRowsByHashSet</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <store_values>Y</store_values>
    <reject_duplicate_row>Y</reject_duplicate_row>
    <error_description>ClienteID duplicado</error_description>
    <fields>
      <field>
        <name>cliente_id</name>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>360</xloc>
      <yloc>170</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Convertir fecha_registro</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <select_unspecified>N</select_unspecified>
      <meta>
        <name>fecha_registro</name>
        <rename>fecha_registro</rename>
        <type>Date</type>
        <length>-2</length>
        <precision>-2</precision>
        <conversion_mask>yyyy-MM-dd</conversion_mask>
        <date_format_lenient>false</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>false</lenient_string_to_number>
        <encoding/>
        <decimal_symbol>.</decimal_symbol>
        <grouping_symbol/>
        <currency_symbol/>
        <storage_type/>
      </meta>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>520</xloc>
      <yloc>170</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Ordenar por cliente_id</name>
    <type>SortRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <directory>%%java.io.tmpdir%%</directory>
    <prefix>out</prefix>
    <sort_size>1000000</sort_size>
    <free_memory/>
    <compress>N</compress>
    <compress_variable/>
    <unique_rows>N</unique_rows>
    <fields>
      <field>
        <name>cliente_id</name>
        <ascending>Y</ascending>
        <case_sensitive>Y</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>680</xloc>
      <yloc>170</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Asignar cliente_key</name>
    <type>Sequence</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <valuename>cliente_key</valuename>
    <use_database>N</use_database>
    <connection/>
    <schema/>
    <seqname>SEQ_</seqname>
    <use_counter>Y</use_counter>
    <counter_name/>
    <start_at>1</start_at>
    <increment_by>1</increment_by>
    <max_value>999999999</max_value>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>840</xloc>
      <yloc>170</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Leer segmentos de K-means</name>
    <type>CsvInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${Internal.Entry.Current.Directory}/../mining/output/segmentos_cliente.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>&quot;</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>cliente_id_seg</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>segmento_cluster</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>1000</xloc>
      <yloc>280</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Agregar segmento_cluster</name>
    <type>StreamLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <from>Leer segmentos de K-means</from>
    <input_sorted>N</input_sorted>
    <preserve_memory>Y</preserve_memory>
    <sorted_list>N</sorted_list>
    <integer_pair>N</integer_pair>
    <lookup>
      <key>
        <name>cliente_id</name>
        <field>cliente_id_seg</field>
      </key>
      <value>
        <name>segmento_cluster</name>
        <rename>segmento_cluster</rename>
        <default/>
        <type>Integer</type>
      </value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>1000</xloc>
      <yloc>170</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Cargar Dim_Cliente</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>AndinaRetailDW</connection>
    <schema>dbo</schema>
    <table>Dim_Cliente</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>cliente_key</column_name>
        <stream_name>cliente_key</stream_name>
      </field>
      <field>
        <column_name>cliente_id</column_name>
        <stream_name>cliente_id</stream_name>
      </field>
      <field>
        <column_name>nombre</column_name>
        <stream_name>nombre</stream_name>
      </field>
      <field>
        <column_name>segmento</column_name>
        <stream_name>segmento</stream_name>
      </field>
      <field>
        <column_name>fecha_registro</column_name>
        <stream_name>fecha_registro</stream_name>
      </field>
      <field>
        <column_name>segmento_cluster</column_name>
        <stream_name>segmento_cluster</stream_name>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>1160</xloc>
      <yloc>170</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Rechazo: ClienteID duplicado</name>
    <type>Constant</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>hoja</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>Clientes</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>causa</name>
        <type>String</type>
