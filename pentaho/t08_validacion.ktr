  <step>
    <name>¿Todo coincide?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Carga validada</send_true_to>
    <send_false_to>Detener: la carga no coincide</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
          <condition>
            <negated>N</negated>
            <leftvalue>xl_ventas_filas</leftvalue>
            <function>=</function>
            <rightvalue>ventas_cargadas_mas_rech</rightvalue>
          </condition>
          <condition>
            <operator>AND</operator>
            <negated>N</negated>
            <leftvalue>xl_clientes</leftvalue>
            <function>=</function>
            <rightvalue>clientes_cargados_mas_rech</rightvalue>
          </condition>
          <condition>
            <operator>AND</operator>
            <negated>N</negated>
            <leftvalue>xl_finanzas_filas</leftvalue>
            <function>=</function>
            <rightvalue>finanzas_cargadas_mas_rech</rightvalue>
          </condition>
          <condition>
            <operator>AND</operator>
            <negated>N</negated>
            <leftvalue>dif_ventas_total</leftvalue>
            <function>&lt;</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>Number</type>
              <text>0.01</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
          </condition>
          <condition>
            <operator>AND</operator>
            <negated>N</negated>
            <leftvalue>dif_ingresos</leftvalue>
            <function>&lt;</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>Number</type>
              <text>0.01</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask/>
            </value>
          </condition>
          <condition>
            <operator>AND</operator>
            <negated>N</negated>
            <leftvalue>xl_visitas</leftvalue>
            <function>=</function>
            <rightvalue>dw_visitas</rightvalue>
          </condition>
          <condition>
            <operator>AND</operator>
            <negated>N</negated>
            <leftvalue>xl_conversiones</leftvalue>
            <function>=</function>
            <rightvalue>dw_conversiones</rightvalue>
          </condition>
          <condition>
            <operator>AND</operator>
            <negated>N</negated>
            <leftvalue>dw_trafico_filas</leftvalue>
            <function>=</function>
            <rightvalue>dw_clientes</rightvalue>
          </condition>
          <condition>
            <operator>AND</operator>
            <negated>N</negated>
            <leftvalue>dw_dias</leftvalue>
            <function>=</function>
            <rightvalue>esp_dias</rightvalue>
          </condition>
          <condition>
            <operator>AND</operator>
            <negated>N</negated>
            <leftvalue>dw_meses</leftvalue>
            <function>=</function>
            <rightvalue>esp_meses</rightvalue>
          </condition>
          <condition>
