  <step>
    <name>Conteos del Datawarehouse</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>AndinaRetailDW</connection>
    <sql>SELECT
  (SELECT COUNT(*) FROM dbo.Hecho_Ventas) AS dw_ventas_filas,
  (SELECT CAST(SUM(total) AS DECIMAL(14,2)) FROM dbo.Hecho_Ventas) AS dw_ventas_total,
  (SELECT COUNT(*) FROM dbo.Hecho_Finanzas_Mensual) AS dw_finanzas_filas,
  (SELECT CAST(SUM(ingresos) AS DECIMAL(14,2)) FROM dbo.Hecho_Finanzas_Mensual) AS dw_ingresos,
  (SELECT COUNT(*) FROM dbo.Hecho_Trafico_Web) AS dw_trafico_filas,
  (SELECT SUM(visitas_web) FROM dbo.Hecho_Trafico_Web) AS dw_visitas,
  (SELECT SUM(conversiones_web) FROM dbo.Hecho_Trafico_Web) AS dw_conversiones,
  (SELECT COUNT(*) FROM dbo.Dim_Tiempo) AS dw_dias,
  (SELECT COUNT(*) FROM dbo.Dim_Mes) AS dw_meses,
  (SELECT COUNT(*) FROM dbo.Dim_Cliente) AS dw_clientes,
  (SELECT COUNT(*) FROM dbo.Dim_Producto) AS dw_productos,
  (SELECT COUNT(*) FROM dbo.Dim_Canal) AS dw_canales,
  (SELECT COUNT(*) FROM dbo.Dim_Vendedor) AS dw_vendedores,
  (SELECT COUNT(*) FROM dbo.Dim_Region) AS dw_regiones,
  (SELECT COUNT(*) FROM dbo.Etl_Rechazos WHERE hoja = N'Ventas') AS rech_ventas,
  (SELECT COUNT(*) FROM dbo.Etl_Rechazos WHERE hoja = N'Clientes') AS rech_clientes,
  (SELECT COUNT(*) FROM dbo.Etl_Rechazos WHERE hoja = N'Finanzas_Mensual') AS rech_finanzas,
  (SELECT COUNT(*) FROM dbo.Etl_Rechazos) AS rechazos,
  (SELECT COUNT(*) FROM dbo.Etl_Observaciones) AS observaciones</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>40</xloc>
      <yloc>470</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
