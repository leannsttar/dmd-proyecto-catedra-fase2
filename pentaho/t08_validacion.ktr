<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>t08_validacion</name>
    <description>Compara conteos y totales del Datawarehouse con el Excel (Fase 1, Tabla 9: Validación).</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
      <parameter>
        <name>DW_HOST</name>
        <default_value>localhost</default_value>
        <description>Servidor de SQL Server</description>
      </parameter>
      <parameter>
        <name>DW_PORT</name>
        <default_value>1433</default_value>
        <description>Puerto TCP de SQL Server</description>
      </parameter>
      <parameter>
        <name>DW_DB</name>
        <default_value>AndinaRetailDW</default_value>
        <description>Base de datos del Datawarehouse</description>
      </parameter>
    </parameters>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <capture_step_performance>N</capture_step_performance>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
    <notepad>
      <note>La carga es correcta si en cada hoja las filas leídas = cargadas + rechazadas, y si los totales y las dimensiones coinciden con el archivo. Si algo no cuadra, Abort detiene el job con error.</note>
      <xloc>40</xloc>
      <yloc>20</yloc>
      <width>760</width>
      <heigth>60</heigth>
      <fontname>Segoe UI</fontname>
      <fontsize>9</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>244</backgroundcolorgreen>
      <backgroundcolorblue>206</backgroundcolorblue>
      <bordercolorred>100</bordercolorred>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorblue>100</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
  </notepads>
  <connection>
    <name>AndinaRetailDW</name>
    <server>${DW_HOST}</server>
    <type>MSSQLNATIVE</type>
    <access>Native</access>
    <database>${DW_DB}</database>
    <port>${DW_PORT}</port>
    <username/>
    <password>Encrypted </password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute>
        <code>MSSQLUseIntegratedSecurity</code>
        <attribute>true</attribute>
      </attribute>
      <attribute>
        <code>EXTRA_OPTION_MSSQLNATIVE.encrypt</code>
        <attribute>true</attribute>
      </attribute>
      <attribute>
        <code>EXTRA_OPTION_MSSQLNATIVE.trustServerCertificate</code>
        <attribute>true</attribute>
      </attribute>
      <attribute>
        <code>PORT_NUMBER</code>
        <attribute>${DW_PORT}</attribute>
      </attribute>
      <attribute>
        <code>FORCE_IDENTIFIERS_TO_LOWERCASE</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>FORCE_IDENTIFIERS_TO_UPPERCASE</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>IS_CLUSTERED</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>PRESERVE_RESERVED_WORD_CASE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>QUOTE_ALL_FIELDS</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>SUPPORTS_BOOLEAN_DATA_TYPE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>SUPPORTS_TIMESTAMP_DATA_TYPE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>USE_POOLING</code>
        <attribute>N</attribute>
      </attribute>
    </attributes>
  </connection>
  <order>
    <hop>
      <from>Leer hoja Ventas</from>
      <to>Totales de Ventas</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Leer hoja Clientes</from>
      <to>Totales de Clientes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Leer hoja Finanzas_Mensual</from>
      <to>Mes a número</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Mes a número</from>
      <to>Solo meses</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Solo meses</from>
      <to>Totales de Finanzas</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Totales de Ventas</from>
      <to>Unir Excel y DW (1)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Totales de Clientes</from>
      <to>Unir Excel y DW (1)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Unir Excel y DW (1)</from>
      <to>Unir Excel y DW (2)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Totales de Finanzas</from>
      <to>Unir Excel y DW (2)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Unir Excel y DW (2)</from>
      <to>Unir Excel y DW (3)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Conteos del Datawarehouse</from>
      <to>Unir Excel y DW (3)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Unir Excel y DW (3)</from>
      <to>Valores fijos de la Fase 1</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Valores fijos de la Fase 1</from>
      <to>Diferencias</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Diferencias</from>
      <to>Resultado de la validación</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Resultado de la validación</from>
      <to>¿Todo coincide?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>¿Todo coincide?</from>
      <to>Carga validada</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>¿Todo coincide?</from>
      <to>Detener: la carga no coincide</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Leer hoja Ventas</name>
    <type>ExcelInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <header>Y</header>
    <noempty>Y</noempty>
    <stoponempty>N</stoponempty>
    <filefield/>
    <sheetfield/>
    <sheetrownumfield/>
    <rownumfield>fila_excel</rownumfield>
    <limit>0</limit>
    <encoding/>
    <add_to_result_filenames>N</add_to_result_filenames>
    <accept_filenames>N</accept_filenames>
    <accept_field/>
    <accept_stepname/>
    <file>
      <name>${Internal.Entry.Current.Directory}/../data/raw/datos_andina_retail_corp.xlsx</name>
      <filemask/>
      <exclude_filemask/>
      <file_required>Y</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field>
        <name>OrdenID</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>Fecha</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>ClienteID</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>Categoria</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>Producto</name>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
