<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>t02_dim_mes</name>
    <description>Genera Dim_Mes: los 12 meses de 2024, dimensión conformada (Fase 1, Tabla 10).</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
      <parameter>
        <name>DW_HOST</name>
        <default_value>localhost</default_value>
        <description>Servidor de SQL Server</description>
      </parameter>
      <parameter>
        <name>DW_PORT</name>
        <default_value>1433</default_value>
        <description>Puerto TCP de SQL Server</description>
      </parameter>
      <parameter>
        <name>DW_DB</name>
        <default_value>AndinaRetailDW</default_value>
        <description>Base de datos del Datawarehouse</description>
      </parameter>
    </parameters>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <capture_step_performance>N</capture_step_performance>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
    <notepad>
      <note>Generate rows y Add sequence crean los meses del 1 al 12. Value mapper asigna el nombre, el trimestre y el semestre, y Add constants, el año 2024. mes_key = AAAAMM (decisión D1).</note>
      <xloc>40</xloc>
      <yloc>20</yloc>
      <width>620</width>
      <heigth>60</heigth>
      <fontname>Segoe UI</fontname>
      <fontsize>9</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>244</backgroundcolorgreen>
      <backgroundcolorblue>206</backgroundcolorblue>
      <bordercolorred>100</bordercolorred>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorblue>100</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
  </notepads>
  <connection>
    <name>AndinaRetailDW</name>
    <server>${DW_HOST}</server>
    <type>MSSQLNATIVE</type>
    <access>Native</access>
    <database>${DW_DB}</database>
    <port>${DW_PORT}</port>
    <username/>
    <password>Encrypted </password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute>
        <code>MSSQLUseIntegratedSecurity</code>
        <attribute>true</attribute>
      </attribute>
      <attribute>
        <code>EXTRA_OPTION_MSSQLNATIVE.encrypt</code>
        <attribute>true</attribute>
      </attribute>
      <attribute>
        <code>EXTRA_OPTION_MSSQLNATIVE.trustServerCertificate</code>
        <attribute>true</attribute>
      </attribute>
      <attribute>
        <code>PORT_NUMBER</code>
        <attribute>${DW_PORT}</attribute>
      </attribute>
      <attribute>
        <code>FORCE_IDENTIFIERS_TO_LOWERCASE</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>FORCE_IDENTIFIERS_TO_UPPERCASE</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>IS_CLUSTERED</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>PRESERVE_RESERVED_WORD_CASE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>QUOTE_ALL_FIELDS</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>SUPPORTS_BOOLEAN_DATA_TYPE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>SUPPORTS_TIMESTAMP_DATA_TYPE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>USE_POOLING</code>
        <attribute>N</attribute>
      </attribute>
    </attributes>
  </connection>
  <order>
    <hop>
      <from>Generar 12 meses</from>
      <to>Numerar meses</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Numerar meses</from>
      <to>Año 2024</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Año 2024</from>
      <to>Nombre del mes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Nombre del mes</from>
      <to>Trimestre</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Trimestre</from>
      <to>Semestre</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Semestre</from>
      <to>Calcular mes_key</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Calcular mes_key</from>
      <to>Tipos finales</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Tipos finales</from>
      <to>Cargar Dim_Mes</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Generar 12 meses</name>
    <type>RowGenerator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields/>
    <limit>12</limit>
    <never_ending>N</never_ending>
    <interval_in_ms>5000</interval_in_ms>
    <row_time_field>now</row_time_field>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>40</xloc>
      <yloc>150</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Numerar meses</name>
    <type>Sequence</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <valuename>mes_numero</valuename>
    <use_database>N</use_database>
    <connection/>
    <schema/>
    <seqname>SEQ_</seqname>
    <use_counter>Y</use_counter>
    <counter_name/>
    <start_at>1</start_at>
    <increment_by>1</increment_by>
    <max_value>999999999</max_value>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>200</xloc>
      <yloc>150</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Año 2024</name>
    <type>Constant</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>anio</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>2024</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>c100</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>100</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>360</xloc>
      <yloc>150</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Nombre del mes</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>mes_numero</field_to_use>
    <target_field>nombre_mes</target_field>
    <non_match_default/>
    <fields>
      <field>
        <source_value>1</source_value>
        <target_value>Enero</target_value>
      </field>
      <field>
        <source_value>2</source_value>
        <target_value>Febrero</target_value>
      </field>
      <field>
        <source_value>3</source_value>
        <target_value>Marzo</target_value>
      </field>
      <field>
        <source_value>4</source_value>
        <target_value>Abril</target_value>
      </field>
      <field>
        <source_value>5</source_value>
        <target_value>Mayo</target_value>
      </field>
      <field>
        <source_value>6</source_value>
        <target_value>Junio</target_value>
      </field>
      <field>
        <source_value>7</source_value>
        <target_value>Julio</target_value>
      </field>
      <field>
        <source_value>8</source_value>
        <target_value>Agosto</target_value>
      </field>
      <field>
        <source_value>9</source_value>
        <target_value>Septiembre</target_value>
      </field>
      <field>
        <source_value>10</source_value>
        <target_value>Octubre</target_value>
      </field>
      <field>
        <source_value>11</source_value>
        <target_value>Noviembre</target_value>
      </field>
      <field>
        <source_value>12</source_value>
        <target_value>Diciembre</target_value>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>520</xloc>
      <yloc>150</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Trimestre</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>mes_numero</field_to_use>
    <target_field>trimestre_txt</target_field>
    <non_match_default/>
    <fields>
      <field>
        <source_value>1</source_value>
        <target_value>1</target_value>
      </field>
      <field>
        <source_value>2</source_value>
        <target_value>1</target_value>
      </field>
      <field>
        <source_value>3</source_value>
        <target_value>1</target_value>
      </field>
