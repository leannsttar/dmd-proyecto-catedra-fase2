      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>680</xloc>
      <yloc>150</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Semestre</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>mes_numero</field_to_use>
    <target_field>semestre_txt</target_field>
