    </hop>
    <hop>
      <from>Fila de la hoja (rechazos)</from>
      <to>Sumar encabezado (rechazos)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sumar encabezado (rechazos)</from>
