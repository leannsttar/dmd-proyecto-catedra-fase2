    <cache_size>0</cache_size>
    <lookup>
      <schema>dbo</schema>
      <table>Dim_Cliente</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key>
        <name>cliente_id</name>
        <field>cliente_id</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>cliente_key</name>
        <rename>cliente_key</rename>
        <default/>
        <type>Integer</type>
