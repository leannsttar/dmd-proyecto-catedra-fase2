<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>t07_hecho_trafico_web</name>
    <description>Carga Hecho_Trafico_Web desde la hoja Clientes (Fase 1, Tabla 10).</description>
