  <step>
    <name>¿Llaves completas?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Cargar Hecho_Trafico_Web</send_true_to>
    <send_false_to>Rechazo: llave no encontrada</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
          <condition>
            <negated>N</negated>
            <leftvalue>cliente_key</leftvalue>
            <function>IS NOT NULL</function>
            <rightvalue/>
          </condition>
          <condition>
            <operator>AND</operator>
            <negated>N</negated>
            <leftvalue>region_cliente_key</leftvalue>
            <function>IS NOT NULL</function>
            <rightvalue/>
          </condition>
        </conditions>
      </condition>
    </compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>840</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
