        <description>Servidor de SQL Server</description>
      </parameter>
      <parameter>
        <name>DW_PORT</name>
        <default_value>1433</default_value>
        <description>Puerto TCP de SQL Server</description>
      </parameter>
      <parameter>
        <name>DW_DB</name>
