      <field>
        <name>RetornoInversion</name>
        <rename>retorno_excel</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>520</xloc>
      <yloc>170</yloc>
      <draw>Y</draw>
