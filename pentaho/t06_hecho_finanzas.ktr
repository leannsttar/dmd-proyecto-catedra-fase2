      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Renombrar columnas</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>fila_excel</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>Mes</name>
        <rename>mes</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>mes_txt</name>
        <rename>mes_numero</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>Ingresos</name>
        <rename>ingresos</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>CostoVentas</name>
        <rename>costo_ventas</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>GastosOperativos</name>
