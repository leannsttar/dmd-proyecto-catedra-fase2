  <step>
    <name>Mes a número</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>Mes</field_to_use>
    <target_field>mes_txt</target_field>
    <non_match_default/>
    <fields>
      <field>
        <source_value>Enero</source_value>
        <target_value>1</target_value>
      </field>
      <field>
        <source_value>Febrero</source_value>
        <target_value>2</target_value>
      </field>
      <field>
        <source_value>Marzo</source_value>
        <target_value>3</target_value>
      </field>
      <field>
        <source_value>Abril</source_value>
        <target_value>4</target_value>
      </field>
      <field>
        <source_value>Mayo</source_value>
        <target_value>5</target_value>
      </field>
      <field>
        <source_value>Junio</source_value>
        <target_value>6</target_value>
      </field>
      <field>
        <source_value>Julio</source_value>
        <target_value>7</target_value>
      </field>
      <field>
        <source_value>Agosto</source_value>
        <target_value>8</target_value>
      </field>
      <field>
        <source_value>Septiembre</source_value>
        <target_value>9</target_value>
      </field>
      <field>
        <source_value>Octubre</source_value>
        <target_value>10</target_value>
      </field>
      <field>
        <source_value>Noviembre</source_value>
        <target_value>11</target_value>
      </field>
      <field>
        <source_value>Diciembre</source_value>
        <target_value>12</target_value>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>200</xloc>
      <yloc>170</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>¿Es un mes?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Renombrar columnas</send_true_to>
    <send_false_to>Filas que no son registros</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>mes_txt</leftvalue>
        <function>IS NOT NULL</function>
        <rightvalue/>
      </condition>
    </compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>360</xloc>
      <yloc>170</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Filas que no son registros</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
