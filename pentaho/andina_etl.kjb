<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>andina_etl</name>
  <description>ETL de Andina Retail Corp: Excel a Datawarehouse en SQL Server</description>
  <extended_description/>
  <job_version/>
  <directory>/</directory>
  <parameters>
    <parameter>
      <name>DW_HOST</name>
      <default_value>localhost</default_value>
      <description>Servidor de SQL Server</description>
    </parameter>
    <parameter>
      <name>DW_PORT</name>
      <default_value>1433</default_value>
      <description>Puerto TCP de SQL Server</description>
    </parameter>
    <parameter>
      <name>DW_DB</name>
      <default_value>AndinaRetailDW</default_value>
      <description>Base de datos del Datawarehouse</description>
    </parameter>
  </parameters>
  <connection>
    <name>AndinaRetailDW</name>
    <server>${DW_HOST}</server>
    <type>MSSQLNATIVE</type>
    <access>Native</access>
    <database>${DW_DB}</database>
    <port>${DW_PORT}</port>
    <username/>
    <password>Encrypted </password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute>
        <code>MSSQLUseIntegratedSecurity</code>
        <attribute>true</attribute>
      </attribute>
      <attribute>
        <code>EXTRA_OPTION_MSSQLNATIVE.encrypt</code>
        <attribute>true</attribute>
      </attribute>
      <attribute>
        <code>EXTRA_OPTION_MSSQLNATIVE.trustServerCertificate</code>
        <attribute>true</attribute>
      </attribute>
      <attribute>
        <code>PORT_NUMBER</code>
        <attribute>${DW_PORT}</attribute>
      </attribute>
      <attribute>
        <code>FORCE_IDENTIFIERS_TO_LOWERCASE</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>FORCE_IDENTIFIERS_TO_UPPERCASE</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>IS_CLUSTERED</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>PRESERVE_RESERVED_WORD_CASE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>QUOTE_ALL_FIELDS</code>
        <attribute>N</attribute>
      </attribute>
      <attribute>
        <code>SUPPORTS_BOOLEAN_DATA_TYPE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>SUPPORTS_TIMESTAMP_DATA_TYPE</code>
        <attribute>Y</attribute>
      </attribute>
      <attribute>
        <code>USE_POOLING</code>
        <attribute>N</attribute>
      </attribute>
    </attributes>
  </connection>
  <slaveservers/>
  <entries>
    <entry>
      <name>START</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <start>Y</start>
      <dummy>N</dummy>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>40</xloc>
      <yloc>120</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Limpieza: recrear tablas</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql/>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>T</sqlfromfile>
      <sqlfilename>${Internal.Entry.Current.Directory}/sql/00_recrear_tablas.sql</sqlfilename>
      <sendOneStatement>F</sendOneStatement>
      <connection>AndinaRetailDW</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>220</xloc>
      <yloc>120</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Detener con error</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <message>El ETL se detuvo: revise el registro de ejecución</message>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>770</xloc>
      <yloc>440</yloc>
      <attributes_kjc/>
    </entry>
