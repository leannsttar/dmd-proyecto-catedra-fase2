table Dim_Canal
	lineageTag: bae1f82c-452a-42e5-bb2e-ae0cfc4470a8

	column canal_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0f6cd076-d927-416e-bd75-29f5432d328a
		summarizeBy: none
		sourceColumn: canal_key

		changedProperty = IsHidden

