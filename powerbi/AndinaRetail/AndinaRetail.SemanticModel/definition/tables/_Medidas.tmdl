		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 58ef2cf1-1fe7-4600-91a1-eed0603893f9

	measure 'Indice gastos operativos %' = DIVIDE ( [Gastos operativos], [Ingresos] )
