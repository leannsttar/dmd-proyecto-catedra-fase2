table _Medidas
	lineageTag: 93dc64bb-b2f1-4f14-8521-40b598ba441b

	measure Ventas = SUM ( Hecho_Ventas[total] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 12b51144-2f37-4568-ab51-114280d46958

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure Ordenes = DISTINCTCOUNT ( Hecho_Ventas[orden_id] )
		formatString: 0
		lineageTag: c62aa10e-11d0-4a19-ae57-696b9aee9d84

	measure Unidades = SUM ( Hecho_Ventas[cantidad] )
		formatString: 0
		lineageTag: e5f2c7aa-203d-4820-86fc-85a514a9de89

	measure 'Clientes con compra' = DISTINCTCOUNT ( Hecho_Ventas[cliente_key] )
		formatString: 0
		lineageTag: 4f763c0f-ef20-4a7f-9414-3e897949475e

	measure 'Ticket promedio' = DIVIDE ( [Ventas], [Ordenes] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 873adb07-143b-4adb-9c8f-f0f8bbb55fcc

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Ventas por cliente' = DIVIDE ( [Ventas], [Clientes con compra] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: e8cb7829-ee55-46ad-a75a-0f76dd1a605a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Ventas E-commerce' = CALCULATE ( [Ventas], Dim_Canal[canal] = "E-commerce" )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 15b4699d-06da-400b-9a4e-b6c3cb34174a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Participacion e-commerce %' = DIVIDE ( [Ventas E-commerce], [Ventas] )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 01538fac-a776-4420-a555-17ce3883c4e4

	measure 'Ventas mes anterior' = ```
			
			        VAR anio = MAX ( Dim_Mes[anio] )
			        VAR mes = MAX ( Dim_Mes[mes_numero] )
			        RETURN IF ( HASONEVALUE ( Dim_Mes[mes_key] ),
			            CALCULATE ( [Ventas], FILTER ( ALL ( Dim_Mes ), Dim_Mes[anio] = anio && Dim_Mes[mes_numero] = mes - 1 ) ) )
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 9858de71-982a-4e1a-b5a2-2acb7e6f7134

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Crecimiento ventas %' = ```
			
			        VAR anterior = [Ventas mes anterior]
			        RETURN IF ( NOT ISBLANK ( anterior ), DIVIDE ( [Ventas] - anterior, anterior ) )
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: eb7cf726-d960-4f8a-8de3-d82c11ea0e89

	measure 'Mes parcial' = ```
			
			        VAR ultima = CALCULATE ( MAX ( Hecho_Ventas[tiempo_key] ), ALL ( Hecho_Ventas ) )
			        VAR fechaUltima = DATE ( INT ( ultima / 10000 ), MOD ( INT ( ultima / 100 ), 100 ), MOD ( ultima, 100 ) )
			        RETURN IF ( HASONEVALUE ( Dim_Mes[mes_key] )
			                    && SELECTEDVALUE ( Dim_Mes[mes_key] ) = INT ( ultima / 100 )
			                    && fechaUltima < EOMONTH ( fechaUltima, 0 ), 1, 0 )
			```
		formatString: 0
		lineageTag: 9a294aab-0987-470c-b000-6d1fbcad5501

	measure Ingresos = SUM ( Hecho_Finanzas_Mensual[ingresos] )
