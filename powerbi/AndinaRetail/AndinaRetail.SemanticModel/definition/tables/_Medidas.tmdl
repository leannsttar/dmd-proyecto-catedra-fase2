	measure 'Margen bruto %' = DIVIDE ( [Ingresos] - [Costo ventas], [Ingresos] )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 2afb2fa0-bdb0-4279-bc13-993025efc5e6

