		lineageTag: f1522bdb-a8fd-49d7-b424-b10b4cf8a2a6

	measure 'Flujo caja acumulado' = ```
			
			        VAR anio = MAX ( Dim_Mes[anio] )
			        VAR mes = MAX ( Dim_Mes[mes_numero] )
			        RETURN CALCULATE ( [Flujo caja], FILTER ( ALL ( Dim_Mes ), Dim_Mes[anio] = anio && Dim_Mes[mes_numero] <= mes ) )
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: e3bc2167-9691-4e08-a174-bbda4aa2472c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Alerta margen bruto' = IF ( [Margen bruto %] < 0.40, 1, 0 )
		formatString: 0
		lineageTag: 1554e318-bf61-44a4-978f-4260c3806ae7

	measure 'Visitas web' = SUM ( Hecho_Trafico_Web[visitas_web] )
